{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mmwx-probe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MMWX_ORIGIN": "https://panel.example.com"
  }
}
